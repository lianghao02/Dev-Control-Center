{
  "mcpServers": {
    "playwright": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@playwright/mcp",
        "--browser",
        "chrome",
        "--allow-unrestricted-file-access"
      ]
    },
    "sqlite": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "mcp-server-sqlite-npx",
        "__HOME_REPO__/cases.db"
      ]
    },
    "Mobbin": {
      "serverUrl": "https://api.mobbin.com/mcp"
    }
  }
}