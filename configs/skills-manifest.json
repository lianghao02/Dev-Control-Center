{
  "schemaVersion": 2,
  "shared": [
    "accesslint",
    "addyosmani-perf",
    "caveman",
    "document-to-markdown",
    "game-design",
    "github-workflow",
    "lianghao-development",
    "product-design",
    "project-planning",
    "project-readiness-check",
    "release-notes",
    "safe-data-processing",
    "taiwan-office-automation",
    "webapp-testing",
    "windows-tool-ux"
  ],
  "codexOnly": [],
  "antigravityOnly": [
    "skill-creator"
  ],
  "projectAgentRouting": {
    "sharedExecution": [
      "scripts/qa.ps1",
      "dotnet-src/scripts/qa.ps1",
      "scripts/test.ps1",
      "scripts/security-check.ps1"
    ],
    "defaultPrompt": "AGENTS.md",
    "codexPrompt": ".agents/AGENTS.md (optional platform-only overrides)",
    "antigravityPrompt": ".gemini/AGENTS.md (optional platform-only overrides)",
    "claudePrompt": "~/.claude/CLAUDE.md (@import central constitution; avoid per-repo CLAUDE.md)",
    "policy": "Project boundaries live in root AGENTS.md; platform subdirs are optional and only used for genuine platform differences. This manifest deploys only global skills across Codex, Antigravity, and Claude Code."
  }
}
